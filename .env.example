# ═══════════════════════════════════════════════════════════
# SEP — Variables de entorno
# Copia este archivo a .env.local y rellena los valores.
# .env.local NUNCA se versiona.
# ═══════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# ⚠️ SALTA RLS POR COMPLETO. Solo en el servidor.
# Nunca con prefijo NEXT_PUBLIC_. Nunca en un archivo "use client".
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ── Sitio ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Email transaccional (Resend) ──────────────────────────
RESEND_API_KEY=""
RESEND_FROM="SEP <hola@sep.edu.pe>"

# ── Pagos (Culqi — Perú) ──────────────────────────────────
NEXT_PUBLIC_CULQI_PUBLIC_KEY=""
CULQI_SECRET_KEY=""
CULQI_WEBHOOK_SECRET=""

# ── Yape / Plin (conciliación manual) ─────────────────────
NEXT_PUBLIC_YAPE_NUMBER="+51946370641"
NEXT_PUBLIC_YAPE_HOLDER="Semillero de Emprendedores Perú"

# ── Anti-spam en formularios públicos ─────────────────────
NEXT_PUBLIC_HCAPTCHA_SITEKEY=""
HCAPTCHA_SECRET=""

# ── Cron de Vercel ────────────────────────────────────────
# Cadena aleatoria larga. Protege /api/cron/*
CRON_SECRET=""

# ── Observabilidad ────────────────────────────────────────
SENTRY_DSN=""
